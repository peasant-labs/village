{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "journey": "playwright test --config playwright.journey.config.mjs",
    "journey:ci": "JOURNEY_HTML=0 playwright test --config playwright.journey.config.mjs",
    "journey:update": "playwright test --config playwright.journey.config.mjs --update-snapshots",
    "journey:report": "playwright show-report scripts/journey/.artifacts/html",
    "lint": "eslint",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run && pnpm run test:mutation",
    "test:mutation": "node scripts/test-contract-compat-mutations.mjs && node scripts/test-transcript-query-guard-mutations.mjs && node scripts/test-grouped-helper-mount-mutations.mjs",
    "probe:explore": "node scripts/visual/probe-explore.mjs",
    "probe:village": "node scripts/visual/probe-village.mjs",
    "shoot:explore": "node scripts/visual/explore-shoot.mjs",
    "shoot:child-sessions": "node scripts/visual/child-session-shoot.mjs",
    "shoot:village": "node scripts/visual/village-shoot.mjs",
    "shoot:manage": "node scripts/visual/manage-shoot.mjs",
    "sxs": "node scripts/visual/stitch-sxs.mjs",
    "sxs:manage": "node scripts/visual/manage-stitch-sxs.mjs",
    "sxs:collective": "node scripts/visual/collective-stitch-sxs.mjs",
    "shoot:demo:helper-groups": "node scripts/visual/demo-helper-groups-shoot.mjs",
    "check:collective-sxs": "NODE_OPTIONS=--no-experimental-webstorage vitest run scripts/visual/collective-sxs-selfcheck.test.mjs",
    "check:journey-vendoring": "NODE_OPTIONS=--no-experimental-webstorage vitest run scripts/journey/lib/vendor-guard.test.mjs",
    "sxs:explore": "SURFACE_SET=cex node scripts/visual/stitch-sxs.mjs",
    "boot:village": "node scripts/visual/boot-village.mjs",
    "boot:manage": "node scripts/visual/manage-boot-village.mjs",
    "boot:explore": "node scripts/visual/boot-explore.mjs",
    "mock:rest:explore": "node scripts/visual/mock-rest-explore.mjs",
    "mock:rest:pagination": "node scripts/visual/mock-rest-pagination.mjs",
    "mock:rest": "node scripts/visual/mock-rest.mjs",
    "shoot:explore:pagination": "node scripts/visual/explore-pagination-shoot.mjs",
    "shoot:profile:collectives": "node scripts/visual/profile-collectives-shoot.mjs",
    "mock:rest:profile": "node scripts/visual/mock-rest-profile.mjs",
    "mock:rest:project": "node scripts/visual/mock-rest-project.mjs",
    "shoot:project": "node scripts/visual/project-page-shoot.mjs",
    "probe:collectives": "node scripts/visual/probe-collectives-standing.mjs",
    "shoot:pull-request": "node scripts/visual/pull-request-shoot.mjs",
    "shoot:profile-prompt-settings": "node scripts/visual/profile-prompt-settings-shoot.mjs"
  },
  "dependencies": {
    "@peasant-labs/fairtrade": "0.0.21",
    "@peasant-labs/schema": "0.23.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.10.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-json-view-lite": "^2.5.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/diff": "^7.0.2",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^30.0.1",
    "puppeteer-core": "^25.2.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
