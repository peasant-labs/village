# See docs/environment.md for what is required vs optional and how to obtain each value.
# Database
DATABASE_URL=postgres://peasant:peasant@localhost:5432/peasant?sslmode=disable

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=peasant-transcripts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true

# Transcript key encryption. Generate each value from 32 random bytes and base64 it.
TRANSCRIPT_KEK_ACTIVE_VERSION=1
TRANSCRIPT_KEK_KEYRING={"1":"replace-with-base64-encoded-32-random-bytes"}

# GitHub OAuth
GITHUB_CLIENT_ID=Ov23ct64YZLmgNBNbjIY
GITHUB_CLIENT_SECRET=

# GitLab OAuth (https://gitlab.com/-/user_settings/applications)
# Redirect URI: <BASE_URL>/api/v1/auth/gitlab/callback
# Scope: read_user
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# Hugging Face OAuth (https://huggingface.co/settings/applications/new)
# Redirect URI: <BASE_URL>/api/v1/auth/huggingface/callback
# Scopes: openid profile
HUGGINGFACE_CLIENT_ID=
HUGGINGFACE_CLIENT_SECRET=

# Codeberg OAuth (Forgejo/Gitea: https://codeberg.org/user/settings/applications)
# Redirect URI: <BASE_URL>/api/v1/auth/codeberg/callback
# Scopes: openid profile
CODEBERG_CLIENT_ID=
CODEBERG_CLIENT_SECRET=

# SourceHut OAuth (https://meta.sr.ht/oauth2)
# Redirect URI is configured on the OAuth app itself (meta.sr.ht does not
# accept a redirect_uri parameter); register: <BASE_URL>/api/v1/auth/sourcehut/callback
# Scope: meta.sr.ht/PROFILE:RO
SOURCEHUT_CLIENT_ID=
SOURCEHUT_CLIENT_SECRET=

# GitHub App (collective repository linking + commit overlay + pull request prompts).
# Register a GitHub App (Settings -> Developer settings -> GitHub Apps).
#   Repository permissions: Contents: Read-only, Metadata: Read-only,
#     Pull requests: Read and write, Checks: Read and write.
#   Subscribe to events: installation, pull_request, check_run, issue_comment.
#   Where can this App be installed: any account (to support public + private repos).
# Then install it on the org/user that owns the repos collectives will link.
# Leave the ID/key empty to fully disable the feature (endpoints return 501).
# GITHUB_APP_PRIVATE_KEY accepts a multi-line PEM, or a single line with \n escapes.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# The App's URL slug (github.com/apps/<slug>), used to build the "Connect GitHub"
# install redirect. Empty disables the install handshake (its routes return 501).
GITHUB_APP_SLUG=
# Webhook secret for the GitHub App: GitHub signs each delivery with it and the
# receiver verifies X-Hub-Signature-256. Generate with: openssl rand -hex 32.
# Must be non-empty for the webhook route to answer anything but 501.
GITHUB_APP_WEBHOOK_SECRET=

# JWT signing secret (change in production)
JWT_SECRET=change-me-in-production

# Server
PORT=8080
BASE_URL=https://localhost
FRONTEND_URL=https://localhost

# Pending encrypted content identities are repaired explicitly with
# `server -backfill-content-identity`; there is no automatic startup job.

# Frontend (used by Next.js; prefix with NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=https://localhost/api/v1
